{
  "name": "leishmy",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "setup": "pnpm install && pnpm db:push && pnpm db:seed",
    "dev:fresh": "pnpm db:push && pnpm db:seed && pnpm dev",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/api-public.spec.ts e2e/public-pages.spec.ts e2e/security.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "preview": "pnpm build && pnpm start",
    "cloudinary:auto-upload": "tsx scripts/configure-auto-upload.ts",
    "cloudinary:verify": "tsx scripts/verify-sign.ts",
    "launch": "tsx scripts/launch.ts",
    "launch:check": "tsx scripts/launch.ts --check-only",
    "launch:dry": "tsx scripts/launch.ts --dry-run",
    "launch:validate": "tsx scripts/validate-env.ts"
  },
  "dependencies": {
    "@cloudinary/url-gen": "^1.22.0",
    "@getbrevo/brevo": "^5.0.4",
    "@neondatabase/auth": "^0.4.2-beta",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.63.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/speed-insights": "^2.0.0",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.22.0",
    "next": "16.2.12",
    "pg": "8.20.0",
    "postal-mime": "^2.7.5",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.1.17",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.25",
    "tailwindcss": "4.1.17",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "better-auth": "1.6.25",
    "@better-auth/core": "1.6.25"
  }
}
